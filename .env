# ======================
# Trading Settings
# ======================
PAIR=SOLUSD
INTERVAL=1
MAX_ROWS=5000
DEFAULT_VOLUME=1.0
ORDER_TYPE=market
TIME_IN_FORCE=gtc
VALIDATE=false

