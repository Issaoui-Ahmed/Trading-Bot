# ======================
# Data Paths
# ======================
DATA_PATH=solusd_data_feats.parquet
SIGNALS_PATH=signals.csv
META_SIGNALS_PATH=meta_signals.csv
ACTIONS_PATH=actions.csv

# ======================
# Model Files
# ======================
XGB_MODEL_PATH=xgb_model.json
XGB_FEATURES_PATH=features.json

LGB_MODEL_PATH=lgb_model.txt
LGB_FEATURES_PATH=features_lgb.json

META_MODEL_PATH=meta_model.json
META_FEATURES_PATH=meta_features.json
META_LABELS_PATH=meta_labels.json

# ======================
# Trading Settings
# ======================
PAIR=SOLUSD
INTERVAL=1
MAX_ROWS=5000
DEFAULT_VOLUME=1.0
ORDER_TYPE=market
TIME_IN_FORCE=gtc
VALIDATE=false

# ======================
# Logging
# ======================
MAIN_LOG_PATH=trading_bot.log
META_LOG_PATH=meta_inference.log
ACTION_LOG_PATH=action.log
BROKER_LOG_PATH=broker.log

# ======================
# API Credentials
# ======================
